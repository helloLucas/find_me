# 각 환경 변수는 실제 값으로 교체해서 사용
# ELASTICSEARCH_URL=Elasticsearch 접속 URL
ELASTICSEARCH_URL=elasticsearch_url

# SPRING_DATASOURCE_URL=Spring JDBC 접속 URL
SPRING_DATASOURCE_URL=spring_datasource_url

# SPRING_DATASOURCE_USERNAME=Spring DB 사용자명
SPRING_DATASOURCE_USERNAME=spring_datasource_username

# SPRING_DATASOURCE_PASSWORD=Spring DB 비밀번호
SPRING_DATASOURCE_PASSWORD=spring_datasource_password

# OPENAI_API_KEY=GMS/OpenAI 호출 API 키
OPENAI_API_KEY=openai_or_gms_api_key

# GMS_ENDPOINT=GMS 호출 전체 엔드포인트 URL
GMS_ENDPOINT=gms_endpoint_url

# MATTERMOST_WEBHOOK_URL=Mattermost 알림 웹훅 URL
MATTERMOST_WEBHOOK_URL=mattermost_webhook_url

# MATTERMOST_REPORT_WEBHOOK_URL=Mattermost 리포트 웹훅 URL
MATTERMOST_REPORT_WEBHOOK_URL=mattermost_report_webhook_url
