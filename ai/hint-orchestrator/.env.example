# 각 환경 변수는 실제 값으로 교체해서 사용
# SERVICE_NAME=서비스 식별 이름
SERVICE_NAME=service_name

# APP_ENV=실행 환경(local/dev/prod)
APP_ENV=local_or_dev_or_prod

# APP_HOST=애플리케이션 바인딩 호스트
APP_HOST=app_bind_host

# APP_PORT=애플리케이션 포트
APP_PORT=app_port

# PG_HOST=PostgreSQL 호스트
PG_HOST=postgres_host

# PG_PORT=PostgreSQL 포트
PG_PORT=postgres_port

# PG_DB=PostgreSQL 데이터베이스명
PG_DB=postgres_db_name

# PG_USER=PostgreSQL 사용자명
PG_USER=postgres_user

# PG_PASSWORD=PostgreSQL 비밀번호
PG_PASSWORD=postgres_password

# REDIS_HOST=Redis 호스트
REDIS_HOST=redis_host

# REDIS_PORT=Redis 포트
REDIS_PORT=redis_port

# REDIS_PASSWORD=Redis 비밀번호
REDIS_PASSWORD=redis_password

# GMS_BASE_URL=GMS API 기본 주소
GMS_BASE_URL=gms_base_url

# GMS_KEY=GMS API 인증 키
GMS_KEY=gms_api_key

# GMS_LLM_PROVIDER=메인 LLM 제공자
GMS_LLM_PROVIDER=llm_provider

# GMS_ROUTER_PROVIDER=라우터 LLM 제공자
GMS_ROUTER_PROVIDER=router_llm_provider

# GMS_LLM_MODEL=메인 힌트 생성 모델
GMS_LLM_MODEL=main_llm_model

# GMS_LIGHT_LLM_MODEL=LIGHT 레벨 힌트 모델
GMS_LIGHT_LLM_MODEL=light_llm_model

# GMS_COMMAND_USAGE_LLM_MODEL=명령 사용 의도 추론 모델
GMS_COMMAND_USAGE_LLM_MODEL=command_usage_llm_model

# GMS_ROUTER_MODEL=의도 라우팅 모델
GMS_ROUTER_MODEL=router_model

# GMS_OPENAI_CHAT_PATH=OpenAI Chat API 경로
GMS_OPENAI_CHAT_PATH=openai_chat_api_path

# GMS_EMBEDDING_MODEL=임베딩 생성 모델
GMS_EMBEDDING_MODEL=embedding_model

# GMS_EMBEDDING_OUTPUT_DIMENSIONALITY=임베딩 벡터 차원 수
GMS_EMBEDDING_OUTPUT_DIMENSIONALITY=embedding_dimensions

# GMS_TIMEOUT_SECONDS=GMS 요청 타임아웃(초)
GMS_TIMEOUT_SECONDS=timeout_seconds

# GMS_MAX_OUTPUT_TOKENS=메인 LLM 최대 출력 토큰
GMS_MAX_OUTPUT_TOKENS=max_output_tokens

# GMS_ROUTER_MAX_OUTPUT_TOKENS=라우터 LLM 최대 출력 토큰
GMS_ROUTER_MAX_OUTPUT_TOKENS=router_max_output_tokens

# GMS_TEMPERATURE=LLM 샘플링 온도
GMS_TEMPERATURE=temperature

# GMS_LLM_REASONING_EFFORT=메인 LLM 추론 강도
GMS_LLM_REASONING_EFFORT=main_reasoning_effort

# GMS_ROUTER_REASONING_EFFORT=라우터 LLM 추론 강도
GMS_ROUTER_REASONING_EFFORT=router_reasoning_effort

# RETRIEVE_DEFAULT_SEARCH_TOP_K=벡터 검색 후보 개수
RETRIEVE_DEFAULT_SEARCH_TOP_K=retrieve_search_top_k

# RETRIEVE_DEFAULT_EVIDENCE_LIMIT=기본 evidence 전달 개수
RETRIEVE_DEFAULT_EVIDENCE_LIMIT=retrieve_evidence_limit

# RETRIEVE_DEFAULT_MIN_SIMILARITY=기본 유사도 하한선
RETRIEVE_DEFAULT_MIN_SIMILARITY=retrieve_min_similarity

# RETRIEVE_EVIDENCE_LIMIT_LIGHT=LIGHT evidence 개수
RETRIEVE_EVIDENCE_LIMIT_LIGHT=light_evidence_limit

# RETRIEVE_EVIDENCE_LIMIT_MEDIUM=MEDIUM evidence 개수
RETRIEVE_EVIDENCE_LIMIT_MEDIUM=medium_evidence_limit

# RETRIEVE_EVIDENCE_LIMIT_STRONG=STRONG evidence 개수
RETRIEVE_EVIDENCE_LIMIT_STRONG=strong_evidence_limit

# HINT_STRESS_FAIL_WEIGHT=오답 횟수 스트레스 가중치
HINT_STRESS_FAIL_WEIGHT=hint_stress_fail_weight

# HINT_STRESS_REPEAT_WEIGHT=반복 질문 스트레스 가중치
HINT_STRESS_REPEAT_WEIGHT=hint_stress_repeat_weight

# HINT_LEVEL_MEDIUM_STRESS_THRESHOLD=MEDIUM 전환 스트레스 임계값
HINT_LEVEL_MEDIUM_STRESS_THRESHOLD=hint_medium_stress_threshold

# HINT_LEVEL_STRONG_STRESS_THRESHOLD=STRONG 전환 스트레스 임계값
HINT_LEVEL_STRONG_STRESS_THRESHOLD=hint_strong_stress_threshold

# HINT_REPEAT_SIMILARITY_THRESHOLD=반복 질문 판정 유사도 임계값
HINT_REPEAT_SIMILARITY_THRESHOLD=hint_repeat_similarity_threshold

# HINT_REPEAT_TTL_SECONDS=반복 질문 상태 TTL(초)
HINT_REPEAT_TTL_SECONDS=hint_repeat_ttl_seconds

# HINT_REPEAT_SLIDING_TTL=반복 질문 TTL 갱신 여부
HINT_REPEAT_SLIDING_TTL=true_or_false

# HINT_USER_MESSAGE_MAX_LENGTH=사용자 입력 최대 길이
HINT_USER_MESSAGE_MAX_LENGTH=hint_user_message_max_length

# VECTOR_SOURCE_FILTER=지식 검색 source 필터
VECTOR_SOURCE_FILTER=vector_source_filter

# VECTOR_KNOWLEDGE_KIND_FILTER=지식 검색 kind 필터
VECTOR_KNOWLEDGE_KIND_FILTER=vector_knowledge_kind_filter

# HINT_COMMAND_USAGE_ROUTING_ENABLED=명령 사용 라우팅 기능 사용 여부
HINT_COMMAND_USAGE_ROUTING_ENABLED=true_or_false

# HINT_COMMAND_USAGE_EMBED_RESOLVER_ENABLED=명령 키→실제 명령 치환 사용 여부
HINT_COMMAND_USAGE_EMBED_RESOLVER_ENABLED=true_or_false

# HINT_COMMAND_USAGE_CANDIDATE_TOP_K=명령 usage 후보 검색 개수
HINT_COMMAND_USAGE_CANDIDATE_TOP_K=command_usage_candidate_top_k

# HINT_COMMAND_USAGE_HIGH_CONFIDENCE=명령 usage 고신뢰 임계값
HINT_COMMAND_USAGE_HIGH_CONFIDENCE=command_usage_high_confidence

# HINT_COMMAND_USAGE_MEDIUM_CONFIDENCE=명령 usage 중신뢰 임계값
HINT_COMMAND_USAGE_MEDIUM_CONFIDENCE=command_usage_medium_confidence

# HINT_RUNTIME_PATTERN_RERANK_ENABLED=런타임 패턴 재정렬 사용 여부
HINT_RUNTIME_PATTERN_RERANK_ENABLED=true_or_false

# HINT_RUNTIME_PATTERN_CACHE_SIZE=런타임 패턴 캐시 최대 엔트리
HINT_RUNTIME_PATTERN_CACHE_SIZE=runtime_pattern_cache_size

# HINT_RUNTIME_PATTERN_CACHE_TTL_SECONDS=런타임 패턴 캐시 TTL(초)
HINT_RUNTIME_PATTERN_CACHE_TTL_SECONDS=runtime_pattern_cache_ttl_seconds

# HINT_STATUS_FILE_BOOTSTRAP_ENABLED=상태 파일 부트스트랩 사용 여부
HINT_STATUS_FILE_BOOTSTRAP_ENABLED=true_or_false

# HINT_STATUS_FILE_BOOTSTRAP_NODES=부트스트랩 대상 노드 목록
HINT_STATUS_FILE_BOOTSTRAP_NODES=bootstrap_node_codes_csv

# HINT_STATUS_FILE_BOOTSTRAP_MESSAGE=부트스트랩 안내 메시지
HINT_STATUS_FILE_BOOTSTRAP_MESSAGE=bootstrap_message
