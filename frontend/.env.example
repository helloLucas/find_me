# 각 환경 변수는 실제 값으로 교체해서 사용
# VITE_API_BASE_URL=프론트 API 기본 URL
VITE_API_BASE_URL=vite_api_base_url

# VITE_CDN_URL=프론트 정적 리소스 CDN URL
VITE_CDN_URL=vite_cdn_url

# VITE_DEV_PROXY_TARGET=개발 프록시 대상 URL
VITE_DEV_PROXY_TARGET=vite_dev_proxy_target

# VITE_DEV_MODE=프론트 개발 모드 여부
VITE_DEV_MODE=true_or_false

# VITE_HMR_HOST=Vite HMR 호스트
VITE_HMR_HOST=vite_hmr_host

# VITE_HMR_PROTOCOL=Vite HMR 프로토콜(ws/wss)
VITE_HMR_PROTOCOL=ws_or_wss

# VITE_HMR_CLIENT_PORT=Vite HMR 클라이언트 포트
VITE_HMR_CLIENT_PORT=vite_hmr_client_port

# VITE_APP_PORT=프론트 앱 서비스 포트
VITE_APP_PORT=vite_app_port

# VITE_GA4_MEASUREMENT_ID=Google Analytics 4 측정 ID
VITE_GA4_MEASUREMENT_ID=ga4_measurement_id

# VITE_CLARITY_PROJECT_ID=Microsoft Clarity 프로젝트 ID
VITE_CLARITY_PROJECT_ID=clarity_project_id
