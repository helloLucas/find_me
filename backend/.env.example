# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET=

# Server
SERVER_PORT=
CORS_ALLOWED_ORIGINS=

# PostgreSQL
POSTGRES_DB=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_TIMEOUT=3000ms

# Hint RAG
# local(docker backend -> host orchestrator): http://host.docker.internal:8201
# dev/prod: http(s)://<orchestrator-host>:<port>
HINT_ORCHESTRATOR_SERVICE_URL=http://host.docker.internal:8201
HINT_ORCHESTRATOR_TIMEOUT_MS=30000
HINT_SEARCH_TOP_K=7
HINT_EVIDENCE_LIMIT=3
HINT_MIN_SIMILARITY=0.70
HINT_RECENT_ACTION_LIMIT=5
HINT_ES_ENABLED=false
HINT_ES_BASE_URL=
HINT_ES_INDEX_PATTERN=
HINT_ES_TIMEOUT_MS=1500

# User message
HINT_USER_MESSAGE_MAX_LENGTH=
