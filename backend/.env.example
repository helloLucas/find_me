# 각 환경 변수는 실제 값으로 교체해서 사용
# GOOGLE_CLIENT_ID=Google OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=google_oauth_client_id

# GOOGLE_CLIENT_SECRET=Google OAuth 클라이언트 시크릿
GOOGLE_CLIENT_SECRET=google_oauth_client_secret

# SSAFY_CLIENT_ID=SSAFY OAuth 클라이언트 ID
SSAFY_CLIENT_ID=ssafy_oauth_client_id

# SSAFY_CLIENT_SECRET=SSAFY OAuth 클라이언트 시크릿
SSAFY_CLIENT_SECRET=ssafy_oauth_client_secret

# JWT_SECRET=JWT 서명 키
JWT_SECRET=jwt_secret

# SERVER_PORT=Backend 서버 포트
SERVER_PORT=server_port

# CORS_ALLOWED_ORIGINS=허용 CORS Origin 목록
CORS_ALLOWED_ORIGINS=cors_allowed_origins_csv

# FRONTEND_URL=OAuth/리다이렉트용 프론트 URL
FRONTEND_URL=frontend_url

# POSTGRES_DB=로컬 PostgreSQL 데이터베이스명
POSTGRES_DB=postgres_db_name

# SPRING_DATASOURCE_URL=Spring JDBC 접속 URL
SPRING_DATASOURCE_URL=spring_datasource_url

# SPRING_DATASOURCE_USERNAME=Spring DB 사용자명
SPRING_DATASOURCE_USERNAME=spring_datasource_username

# SPRING_DATASOURCE_PASSWORD=Spring DB 비밀번호
SPRING_DATASOURCE_PASSWORD=spring_datasource_password

# REDIS_HOST=Redis 호스트
REDIS_HOST=redis_host

# REDIS_PORT=Redis 포트
REDIS_PORT=redis_port

# REDIS_PASSWORD=Redis 비밀번호
REDIS_PASSWORD=redis_password

# REDIS_TIMEOUT=Redis 연결/응답 타임아웃
REDIS_TIMEOUT=redis_timeout

# MAIL_USERNAME=SMTP 계정 아이디
MAIL_USERNAME=smtp_username

# MAIL_PASSWORD=SMTP 계정 비밀번호/앱 비밀번호
MAIL_PASSWORD=smtp_password

# AWS_ACCESS_KEY=AWS Access Key
AWS_ACCESS_KEY=aws_access_key

# AWS_SECRET_KEY=AWS Secret Key
AWS_SECRET_KEY=aws_secret_key

# AWS_REGION=AWS 리전
AWS_REGION=aws_region

# AWS_S3_BUCKET=S3 버킷 이름
AWS_S3_BUCKET=aws_s3_bucket

# AWS_CDN_URL=CloudFront/CDN 배포 URL
AWS_CDN_URL=cdn_url

# HINT_ORCHESTRATOR_SERVICE_URL=Backend가 호출할 Hint Orchestrator URL
HINT_ORCHESTRATOR_SERVICE_URL=hint_orchestrator_service_url

# HINT_ORCHESTRATOR_TIMEOUT_MS=Hint Orchestrator 호출 타임아웃(ms)
HINT_ORCHESTRATOR_TIMEOUT_MS=hint_orchestrator_timeout_ms

# HINT_SEARCH_TOP_K=힌트 검색 후보 개수
HINT_SEARCH_TOP_K=hint_search_top_k

# HINT_EVIDENCE_LIMIT=힌트 evidence 전달 개수
HINT_EVIDENCE_LIMIT=hint_evidence_limit

# HINT_MIN_SIMILARITY=힌트 최소 유사도
HINT_MIN_SIMILARITY=hint_min_similarity

# HINT_RECENT_ACTION_LIMIT=최근 액션 조회 개수
HINT_RECENT_ACTION_LIMIT=hint_recent_action_limit

# HINT_ES_ENABLED=Elasticsearch 로그 조회 사용 여부
HINT_ES_ENABLED=true_or_false

# HINT_ES_BASE_URL=Elasticsearch 기본 URL
HINT_ES_BASE_URL=hint_es_base_url

# HINT_ES_INDEX_PATTERN=Elasticsearch 인덱스 패턴
HINT_ES_INDEX_PATTERN=hint_es_index_pattern

# HINT_ES_TIMEOUT_MS=Elasticsearch 조회 타임아웃(ms)
HINT_ES_TIMEOUT_MS=hint_es_timeout_ms

# HINT_USER_MESSAGE_MAX_LENGTH=사용자 입력 최대 길이
HINT_USER_MESSAGE_MAX_LENGTH=hint_user_message_max_length

# ADMIN_PIN_CODE=관리자 PIN 코드
ADMIN_PIN_CODE=admin_pin_code

# ADMIN_PIN_TOKEN_EXPIRED_MS=관리자 PIN 토큰 만료시간(ms)
ADMIN_PIN_TOKEN_EXPIRED_MS=admin_pin_token_expired_ms

# ADMIN_ANALYTICS_ES_ENABLED=관리자 분석 ES 기능 사용 여부
ADMIN_ANALYTICS_ES_ENABLED=true_or_false

# ADMIN_ANALYTICS_ES_BASE_URL=관리자 분석 ES URL
ADMIN_ANALYTICS_ES_BASE_URL=admin_analytics_es_base_url

# ADMIN_ANALYTICS_ES_INDEX_PATTERN=관리자 분석 ES 인덱스 패턴
ADMIN_ANALYTICS_ES_INDEX_PATTERN=admin_analytics_es_index_pattern

# ADMIN_ANALYTICS_ES_TIMEOUT_MS=관리자 분석 ES 타임아웃(ms)
ADMIN_ANALYTICS_ES_TIMEOUT_MS=admin_analytics_es_timeout_ms
